SPORT_RUNTIME_HOST=0.0.0.0
SPORT_RUNTIME_PORT=8080
SPORT_RUNTIME_MAX_BODY_BYTES=524288
# Optional but recommended on any routable network. Minimum 32 characters when set.
SPORT_RUNTIME_BEARER_TOKEN=replace-with-at-least-32-random-characters

# Provider configuration. Any OpenAI-compatible chat-completions endpoint can be used.
SPORT_PROVIDER_ID=internal-openai-compatible
SPORT_PROVIDER_ENDPOINT=http://llm.internal:11434/v1/chat/completions
SPORT_MODEL_ID=replace-with-qualified-model
SPORT_PROVIDER_TIMEOUT_SECONDS=60
# Leave blank for an internal endpoint without authentication.
SPORT_PROVIDER_API_KEY_ENV=
# If SPORT_PROVIDER_API_KEY_ENV is set, define the referenced variable too, for example:
# LLM_API_KEY=...

# Set to the deployed Skillz commit SHA for audit provenance.
SKILLZ_REVISION=replace-with-deployed-skillz-sha

# Alternative to the SPORT_PROVIDER_* values above:
# SPORT_RUNTIME_PROVIDER_CONFIG=/run/secrets/provider-config.json
